# Data & large artifacts (never commit) — keep the dirs, ignore their contents
/data/
/feature_cache/*
!/feature_cache/.gitkeep
/outputs/*
!/outputs/.gitkeep
*.jpg
*.jpeg
*.png
!docs/**/*.png

# Python
__pycache__/
*.egg-info/
.pytest_cache/
.venv/
venv/
*.pyc

# OS / editor
.DS_Store
.idea/
.vscode/
.claude/

# Personal interview preparation — local only, including compiled/exported copies
/docs/interview_book/
/docs/interview_book.*
/docs/interview_prep.*
/interview_book/
/interview_book.*
/interview_prep.*

# Generated notebook and LaTeX build files (keep report sources and final PDFs)
.ipynb_checkpoints/
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.lof
*.lot
*.bbl
*.blg
*.bcf
*.run.xml
